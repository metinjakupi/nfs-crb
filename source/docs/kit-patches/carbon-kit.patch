+// Need for Speed Carbon (ws2_32 by name, advapi32, rpcrt4, ole32). Online
+// play is gone, so these only have to answer the probes the game makes at
+// start-up: an admin check, a random seed and a GUID for the profile.
+void w_htons(X86 *c) {
+    uint32_t v = arg(c, 0) & 0xffff;
+    set_eax(c, ((v & 0xff) << 8) | (v >> 8));
+}
+void w_htonl(X86 *c) {
+    uint32_t v = arg(c, 0);
+    set_eax(c, (v >> 24) | ((v >> 8) & 0xff00) | ((v << 8) & 0xff0000) | (v << 24));
+}
+void w_inet_addr(X86 *c) {
+    unsigned a, b, cc, d;
+    char tail;
+    std::string text = gm_str(arg(c, 0), 64);
+    if (sscanf(text.c_str(), "%u.%u.%u.%u%c", &a, &b, &cc, &d, &tail) == 4 && a < 256 && b < 256 &&
+        cc < 256 && d < 256)
+        set_eax(c, a | (b << 8) | (cc << 16) | (d << 24)); // network byte order
+    else
+        set_eax(c, 0xffffffffu); // INADDR_NONE
+}
+void fill_random(uint32_t p, uint32_t n) {
+    static uint64_t state = 0;
+    if (!state)
+        state = os_monotonic_ns() ^ (uint64_t)(uintptr_t)&state ^ 0x9e3779b97f4a7c15ull;
+    for (uint32_t i = 0; i < n; ++i) {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        wr8(p + i, (uint8_t)state);
+    }
+}
+void a_AllocateAndInitializeSid(X86 *c) {
+    uint32_t out = arg(c, 10);
+    if (out && gm_valid(out, 4))
+        wr32(out, 0);
+    set_last_error(5); // ERROR_ACCESS_DENIED: no SIDs here
+    set_eax(c, 0);
+}
+void a_CheckTokenMembership(X86 *c) {
+    uint32_t member = arg(c, 2);
+    if (member && gm_valid(member, 4))
+        wr32(member, 0); // not an administrator
+    set_eax(c, 1);
+}
+void a_CryptAcquireContextA(X86 *c) {
+    uint32_t out = arg(c, 0);
+    if (out && gm_valid(out, 4))
+        wr32(out, 0x43525950u); // any nonzero provider handle
+    set_eax(c, out ? 1 : 0);
+}
+void a_CryptGenRandom(X86 *c) {
+    uint32_t n = arg(c, 1), p = arg(c, 2);
+    bool ok = p && gm_valid(p, n);
+    if (ok)
+        fill_random(p, n);
+    set_eax(c, ok ? 1 : 0);
+}
+void o_CoCreateGuid(X86 *c) {
+    uint32_t p = arg(c, 0);
+    if (!p || !gm_valid(p, 16)) {
+        set_eax(c, 0x80070057u); // E_INVALIDARG
+        return;
+    }
+    fill_random(p, 16);
+    wr8(p + 7, (uint8_t)((rd8(p + 7) & 0x0f) | 0x40)); // version 4
+    wr8(p + 8, (uint8_t)((rd8(p + 8) & 0x3f) | 0x80)); // RFC 4122 variant
+    set_eax(c, 0);
+}
+void r_UuidToStringA(X86 *c) {
+    uint32_t u = arg(c, 0), out = arg(c, 1);
+    if (!u || !out || !gm_valid(u, 16) || !gm_valid(out, 4)) {
+        set_eax(c, 1702); // RPC_S_INVALID_ARG
+        return;
+    }
+    char tmp[40];
+    snprintf(tmp, sizeof tmp, "%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x", rd32(u), rd16(u + 4),
+             rd16(u + 6), rd8(u + 8), rd8(u + 9), rd8(u + 10), rd8(u + 11), rd8(u + 12), rd8(u + 13),
+             rd8(u + 14), rd8(u + 15));
+    uint32_t buf = heap_alloc(40, true);
+    if (!buf) {
+        set_eax(c, 14); // RPC_S_OUT_OF_MEMORY
+        return;
+    }
+    gm_put_str(buf, tmp, 40);
+    wr32(out, buf);
+    set_eax(c, 0);
+}
+void r_RpcStringFreeA(X86 *c) {
+    uint32_t p = arg(c, 0);
+    if (p && gm_valid(p, 4)) {
+        uint32_t s = rd32(p);
+        if (s && heap_owns(s))
+            heap_free(s);
+        wr32(p, 0);
+    }
+    set_eax(c, 0);
+}
