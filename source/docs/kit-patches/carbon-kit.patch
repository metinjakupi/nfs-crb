+// Need for Speed Carbon's d3dx9_30 imports that have no implementation yet.
+// Each fails cleanly (null out-pointer, D3DERR_NOTAVAILABLE) and says so once
+// in the log, so bring-up shows which of them the game actually reaches.
+static void d3dx_unavailable(X86 *c, const char *name, int out_arg) {
