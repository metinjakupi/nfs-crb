+// Need for Speed Carbon and its msvcr71/msvcp71 (game.toml [modules.aux]).
+// Guest threads are scheduled cooperatively, so plain reads and writes are
+// atomic with respect to each other, as the Interlocked shims above assume.
+void k_InterlockedCompareExchange(X86 *c) {
+    uint32_t p = arg(c, 0), exchange = arg(c, 1), comparand = arg(c, 2);
+    uint32_t old = rd32(p);
+    if (old == comparand)
+        wr32(p, exchange);
+    set_eax(c, old);
+}
+void k_InterlockedExchangeAdd(X86 *c) {
+    uint32_t p = arg(c, 0), value = arg(c, 1);
+    uint32_t old = rd32(p);
+    wr32(p, old + value);
+    set_eax(c, old);
+}
+void k_SetThreadIdealProcessor(X86 *c) {
+    set_eax(c, 0); // previous ideal processor
+}
+void k_DisableThreadLibraryCalls(X86 *c) {
+    set_eax(c, 1);
+}
+void k_GetComputerNameA(X86 *c) {
+    static const char name[] = "MAC";
+    uint32_t buf = arg(c, 0), size_ptr = arg(c, 1);
+    if (!size_ptr || !gm_valid(size_ptr, 4)) {
+        set_last_error(87);
+        set_eax(c, 0);
+        return;
+    }
+    uint32_t cap = rd32(size_ptr);
+    if (!buf || cap < sizeof name || !gm_valid(buf, sizeof name)) {
+        wr32(size_ptr, sizeof name);
+        set_last_error(111); // ERROR_BUFFER_OVERFLOW
+        set_eax(c, 0);
+        return;
+    }
+    memcpy(g_mem + buf, name, sizeof name);
+    wr32(size_ptr, sizeof name - 1);
+    set_eax(c, 1);
+}
+void k_LocalFileTimeToFileTime(X86 *c) {
+    k_FileTimeToLocalFileTime(c); // The virtual machine uses UTC both ways.
+}
+void k_LockFile(X86 *c) {
+    set_eax(c, 1); // one process owns the files
+}
