+
+// A device sampler slot holds a reference on a volume texture (Dev_SetTexture
+// takes one and releases it when the slot changes). An effect binding a slot
+// must follow the same rule, or the next Dev_SetTexture on that stage releases
+// a reference nobody took: that freed NFSC's colour-grading volume at race load.
+static void bind_sampler_slot(uint32_t &slot, uint32_t id) {
+    if (slot == id)
+        return;
+    ComObj *nu = com_get(id), *old = com_get(slot);
+    if (nu && nu->kind == K_D3D9VOLUMETEXTURE)
+        com_addref(nu);
+    slot = id;
+    if (old && old->kind == K_D3D9VOLUMETEXTURE)
+        com_release(old);
+}
