+
+// Point a parameter at a texture, moving the reference it holds.
+static void set_param_texture(FxParam &p, uint32_t id) {
+    if (p.texture == id)
+        return;
+    if (ComObj *tex = com_get(id))
+        com_addref(tex);
+    if (ComObj *old = com_get(p.texture))
+        com_release(old);
+    p.texture = id;
 }
 
