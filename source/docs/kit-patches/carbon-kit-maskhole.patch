+    def slot_in_code(self, fn, at):
+        """Do the four bytes at `at` overlap an instruction listed in `fn`?"""
+        for k, ins in enumerate(fn.insns):
+            end = fn.fallthrough[k] if fn.fallthrough[k] is not None else ins.addr + 1
+            if ins.addr < at + 4 and at < end:
+                return True
