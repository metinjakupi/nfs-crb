+def test_mask_hole_overlapping_the_jump_is_not_an_entry():
+    # msvcr71's memmove: `JMP [ECX*4 + 0x100029ec]` right after another table
+    # jump, AND 3 with 0 diverted. Slot 0 is the previous JMP's displacement -
+    # the address of a different table - which is plausible as code but sits
+    # inside an instruction, so it is a hole, not a target.
+    class Sized(FakeImage):
+        def insn_end(self, addr, mnem):
+            return addr + {"JMP": 7, "AND": 3, "ADD": 2}.get(mnem, 1)
+
+    jmp = FN + 0x05
+    base = jmp + 3                     # slot 0 = bytes 3..6 of the JMP itself
+    lines = [(0x00, "AND ECX,0x3"), (0x03, "ADD EDI,ECX"),
+             (0x05, "JMP dword ptr [ECX*0x4 + 0x%x]" % base),
+             (0x40, "RET"), (0x50, "RET"), (0x60, "RET"), (0x70, "RET")]
+    dwords = {base: FN + 0x40, base + 4: FN + 0x50, base + 8: FN + 0x60, base + 12: FN + 0x70}
+    listing = "\n".join("%08x  %s" % (FN + off, text) for off, text in lines) + "\n"
+    insns = T.parse_listing_text(listing)
+    fn = T.Function(FN, "case", 0x100, insns)
+    image = Sized([i.addr for i in insns], dwords)
+    fn.measure(image)
+    tr = T.Translator(image, {FN}, Opts())
+    tr.prepare(fn, strict=True)
+    assert sorted(tr.jumptables[(FN, jmp)]) == [FN + 0x50, FN + 0x60, FN + 0x70]
